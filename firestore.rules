rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /boomPanicRooms/{roomCode} {
      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.expiresAt is number;
      allow get: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.expiresAt > request.time.toMillis()
        && !('guestId' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestId'])
        && request.resource.data.guestId == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.hostId == request.auth.uid || resource.data.guestId == request.auth.uid);

      match /messages/{messageId} {
        allow get, list: if request.auth != null
          && exists(/databases/$(database)/documents/boomPanicRooms/$(roomCode))
          && (get(/databases/$(database)/documents/boomPanicRooms/$(roomCode)).data.hostId == request.auth.uid
            || get(/databases/$(database)/documents/boomPanicRooms/$(roomCode)).data.guestId == request.auth.uid);
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/boomPanicRooms/$(roomCode))
          && (get(/databases/$(database)/documents/boomPanicRooms/$(roomCode)).data.hostId == request.auth.uid
            || get(/databases/$(database)/documents/boomPanicRooms/$(roomCode)).data.guestId == request.auth.uid)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.message is map;
      }
    }
  }
}
