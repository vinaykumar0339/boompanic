{
  "expo": {
    "name": "Boom Panic",
    "slug": "boom-panic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/boom-app-icon.png",
    "scheme": "bombpanic",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "BoomPanic uses your local network to create and join games with nearby friends."
      },
      "bundleIdentifier": "com.vinaykumar9961.BoomPanic.ios"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080E26",
        "foregroundImage": "./assets/images/boom-app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.vinaykumar9961.BoomPanic.android"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/boom-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080E26",
          "image": "./assets/images/boom-app-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BoomPanic to scan a game QR code.",
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
